HOST=127.0.0.1
PORT=3100

GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_NAME=
GOOGLE_SHEET_RANGE=A1:I1000
HIDE_NON_EDITABLE_SHEETS=true
GOOGLE_APPS_SCRIPT_ID=your_apps_script_project_id
GOOGLE_APPS_SCRIPT_DEV_MODE=false
REPORT_FUNCTION_PREFIX=надіслатиЗвіт_

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/oauth2callback

DATA_DIR=.data
AUTH_STORE_FILE=auth-store.json
SHEET_ACCESS_FILE=sheet-access.json
SESSION_COOKIE_NAME=inventory_session
SESSION_TTL_HOURS=168
