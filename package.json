{
  "name": "inventory-status-app",
  "version": "1.0.0",
  "private": true,
  "description": "Local app for parsing inventory rows from Google Sheets and updating item statuses.",
  "main": "index.js",
  "scripts": {
    "start": "node local-dev.js",
    "start:local": "node local-dev.js",
    "start:function": "node server.js",
    "check": "node --check server.js && node --check index.js && node --check public/script.js",
    "deploy": "firebase deploy",
    "deploy:production": "firebase deploy --project project-112eca27-802a-43bd-b93",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.2",
    "googleapis": "^148.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.22.4"
  }
}
