{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".data",
      ".env",
      ".env.*",
      "credentials*.json",
      "token*.json"
    ]
  },
  "hosting": {
    "site": "project-112eca27-802a-43bd-b93",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "app",
          "region": "europe-west1"
        }
      },
      {
        "source": "/auth/google",
        "function": {
          "functionId": "app",
          "region": "europe-west1"
        }
      },
      {
        "source": "/oauth2callback",
        "function": {
          "functionId": "app",
          "region": "europe-west1"
        }
      },
      {
        "source": "/logout",
        "function": {
          "functionId": "app",
          "region": "europe-west1"
        }
      },
      {
        "source": "/reauth",
        "function": {
          "functionId": "app",
          "region": "europe-west1"
        }
      }
    ]
  }
}
