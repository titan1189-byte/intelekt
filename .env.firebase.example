AUTH_STORE_BACKEND=firestore
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-firebase-project-id.web.app/oauth2callback

GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_RANGE=A1:I1000
HIDE_NON_EDITABLE_SHEETS=true

# WhatsApp report is generated from the summary sheet, without Apps Script UI.
REPORT_SUMMARY_SHEET=Зведена інформація
REPORT_SUMMARY_FIRST_ROW=3
REPORT_PERIOD_CELL=F1
REPORT_UNIT_SUMMARY_COLUMNS={"1 РБпАК":1,"1 РУБпАК":5,"2 РБпАК":9,"НРК":13,"2 РУБпАК":17,"Грек":21}

SESSION_COOKIE_NAME=__session
SESSION_TTL_HOURS=168

# Optional: app-level sheet access rules as JSON.
# SHEET_ACCESS_JSON={"default":[],"users":{"operator@example.com":["968282677"]}}
